# Локальная база SQLite (создаётся автоматически при запуске)
/data/*.sqlite
/data/*.sqlite-wal
/data/*.sqlite-shm

# Файлы, загруженные через админку (кроме служебных)
/uploads/*
!/uploads/.htaccess
!/uploads/index.html

# Локальный тест-конфиг (SQLite) — только для разработки, не для хостинга
/config.local.php

# Системный мусор
Thumbs.db
desktop.ini
.DS_Store
*.log
