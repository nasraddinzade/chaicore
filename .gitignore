# Локальная база SQLite (создаётся автоматически при запуске)
/data/*.sqlite
/data/*.sqlite-wal
/data/*.sqlite-shm

# Файлы, загруженные через админку (кроме служебных)
/uploads/*
!/uploads/.htaccess
!/uploads/index.html

# Реальные доступы к базе — НЕ в репозиторий (в GitHub только config.example.php)
/config.php

# Системный мусор
Thumbs.db
desktop.ini
.DS_Store
*.log
